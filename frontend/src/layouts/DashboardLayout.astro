---
import BaseLayout from "./BaseLayout.astro";
import { Sidebar } from "@/components/layout/Sidebar";
import { DashboardNavigation } from "@/components/layout/DashboardNavigation";
import { TopNavbar } from "@/components/layout/TopNavbar";
import { apiGet, requireUser } from "@/lib/server";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const currentPath = Astro.url.pathname;

let auth: any = { ok: false, user: null };
let settings: any = { ok: false, body: null };

try {
  const cookie = Astro.request.headers.get("cookie") || "";
  [auth, settings] = await Promise.all([
    requireUser(cookie),
    apiGet("/settings", cookie, true),
  ]);
} catch (e) {
  console.error("DashboardLayout SSR Error:", e);
}

const isSuperAdmin = auth?.ok && auth?.user?.isSuperAdmin === true;
const initialUser = auth?.ok && auth?.user ? {
  name: auth.user.email?.split("@")[0] || "Admin",
  role: auth.user.role || (isSuperAdmin ? "super_admin" : "user"),
  email: auth.user.email,
} : undefined;

const disableRightClick = settings?.ok ? (settings.body?.data?.disable_right_click ?? true) : true;
---

<BaseLayout title={title} description={description} image={image}>
  <div
    class="flex h-screen w-full bg-[#F8FAFC] overflow-hidden"
    id="dashboard-root"
    data-disable-right-click={disableRightClick.toString()}
  >
    <!-- Sidebar Desktop: Berada di container native Astro agar 100% solid dan tidak pernah menciut -->
    <aside class="hidden md:flex md:w-72 md:flex-col h-full flex-shrink-0 bg-white border-r border-slate-200/80 z-30">
      <Sidebar
        client:load
        currentPath={currentPath}
        isSuperAdmin={isSuperAdmin}
      />
    </aside>

    <!-- Sidebar Mobile: Drawer overlay untuk perangkat mobile -->
    <DashboardNavigation
      client:load
      currentPath={currentPath}
      isSuperAdmin={isSuperAdmin}
    />

    <!-- Main Content Area -->
    <div class="flex flex-1 flex-col overflow-hidden min-w-0">
      <div class="w-full flex-shrink-0 z-20">
        <TopNavbar
          client:load
          initialUser={initialUser}
        />
      </div>

      <main class="flex-1 overflow-y-auto overflow-x-hidden p-4 sm:p-6 lg:p-8">
        <div class="mx-auto w-full">
          <slot />
        </div>
      </main>
    </div>
  </div>

  <script is:inline>
    function setupContextMenuGuard() {
      document.addEventListener("contextmenu", function (e) {
        // Biarkan input dan textarea tetap bisa copy/paste browser native
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) {
          return;
        }

        // Biarkan area file browser membuka menu custom context menu
        if (e.target.closest("table") || e.target.closest(".group") || e.target.closest("[data-context-menu]")) {
          return;
        }

        const root = document.getElementById("dashboard-root");
        if (root && root.dataset.disableRightClick === "true") {
          e.preventDefault();
        }
      });
    }

    setupContextMenuGuard();
    document.addEventListener("astro:page-load", setupContextMenuGuard);
  </script>
</BaseLayout>