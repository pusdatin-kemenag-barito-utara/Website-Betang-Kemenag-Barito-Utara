---
import "@fontsource-variable/plus-jakarta-sans";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { MaintenanceListener } from "@/components/layout/MaintenanceListener";
import { ToasterIsland } from "@/components/layout/ToasterIsland";
import MetaTags from "@/components/seo/MetaTags.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import AnalyticsScripts from "@/components/seo/AnalyticsScripts.astro";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
}

const {
  title = "SI BETANG - E-Arsip Kemenag Barito Utara",
  description = "Sistem Informasi Manajemen dan Pengarsipan Digital Terpadu Kantor Kementerian Agama Kabupaten Barito Utara",
  image = "/og-image.png",
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const fullTitle =
  title === "SI BETANG - E-Arsip Kemenag Barito Utara" ? title : `${title} | SI BETANG`;
const siteUrl = (Astro.site?.toString() || Astro.url.origin).replace(/\/+$/, "");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();

// Variabel publik diinjeksi secara dinamis dari proses runtime server Node.js (Infisical) ke browser client
const publicEnv = {
  PUBLIC_TURNSTILE_SITE_KEY:
    (typeof process !== "undefined" &&
      (process.env.PUBLIC_TURNSTILE_SITE_KEY || process.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY)) ||
    import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
    import.meta.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY ||
    "",
  PUBLIC_PUSDATIN_URL:
    (typeof process !== "undefined" &&
      (process.env.PUBLIC_PUSDATIN_URL || process.env.NEXT_PUBLIC_PUSDATIN_URL)) ||
    import.meta.env.PUBLIC_PUSDATIN_URL ||
    import.meta.env.NEXT_PUBLIC_PUSDATIN_URL ||
    "",
  PUBLIC_API_URL:
    (typeof process !== "undefined" &&
      (process.env.PUBLIC_API_URL || process.env.NEXT_PUBLIC_API_URL)) ||
    import.meta.env.PUBLIC_API_URL ||
    import.meta.env.NEXT_PUBLIC_API_URL ||
    "",
  PUBLIC_GA_MEASUREMENT_ID:
    (typeof process !== "undefined" && process.env.PUBLIC_GA_MEASUREMENT_ID) ||
    import.meta.env.PUBLIC_GA_MEASUREMENT_ID ||
    "",
  PUBLIC_GTM_ID:
    (typeof process !== "undefined" && process.env.PUBLIC_GTM_ID) ||
    import.meta.env.PUBLIC_GTM_ID ||
    "",
};
---

<!doctype html>
<html lang="id" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="generator" content={Astro.generator} />

    <!-- 🚀 Client-side Router untuk Transisi Cepat & Persistent Background Uploads -->
    <ClientRouter />

    <!-- 🔑 Injeksi SSR Dinamis Variabel Publik Infisical Runtime -->
    <script is:inline define:vars={{ publicEnv }}>
      window.__PUBLIC_ENV__ = Object.assign(window.__PUBLIC_ENV__ || {}, publicEnv);
    </script>

    <!-- 🌐 DNS-Prefetch & Preconnect -->
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- 🚀 Favicons & PWA Icons -->
    <link rel="icon" type="image/svg+xml" href="/kemenag.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- 📱 PWA & Mobile Web App Meta -->
    <meta name="theme-color" content="#059669" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SI BETANG" />
    <meta name="application-name" content="SI BETANG" />
    <meta name="msapplication-TileColor" content="#059669" />
    <meta name="msapplication-TileImage" content="/pwa-192x192.png" />

    <!-- 🏷️ SEO Meta Tags & JSON-LD Graph -->
    <MetaTags
      fullTitle={fullTitle}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImageUrl={ogImageUrl}
      noindex={noindex}
    />

    <JsonLd
      siteUrl={siteUrl}
      canonicalUrl={canonicalUrl}
      description={description}
      breadcrumbs={breadcrumbs}
    />

    <!-- 📊 Analytics & GTM Tracking -->
    <AnalyticsScripts />
  </head>

  <body
    class="min-h-full flex flex-col bg-slate-50 font-sans text-slate-900 antialiased selection:bg-emerald-500/20 selection:text-emerald-900"
  >
    <slot />

    <!-- React Island Global Components -->
    <ToasterIsland client:load />
    <MaintenanceListener client:load />

    <!-- ⚡ PWA Service Worker Registration -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js", { scope: "/" })
            .then((registration) => {
              registration.addEventListener("updatefound", () => {
                const newWorker = registration.installing;
                if (newWorker) {
                  newWorker.addEventListener("statechange", () => {
                    if (newWorker.state === "installed" && navigator.serviceWorker.controller) {
                      console.log("[PWA] Versi baru aplikasi SI BETANG siap dimuat.");
                    }
                  });
                }
              });
            })
            .catch((err) => {
              console.warn("[PWA] Registrasi Service Worker gagal:", err);
            });
        });
      }
    </script>
  </body>
</html>