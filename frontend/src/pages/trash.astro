---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import PageBanner from "@/components/ui/PageBanner.astro";
import { Trash2 } from "lucide-react";
import { TrashView } from "@/components/Trash/TrashView";
import { apiGet, requireUser } from "@/lib/server";

let auth: any = { ok: false, user: null };
let res: any = { ok: false, body: null };

try {
  const cookie = Astro.request.headers.get("cookie") || "";
  [auth, res] = await Promise.all([
    requireUser(cookie, Astro.response.headers),
    apiGet("/trash", cookie, false, Astro.response.headers),
  ]);
} catch (e) {
  console.error("Trash SSR Error:", e);
}

if (!auth?.ok) {
  return Astro.redirect("/login");
}

const trashRaw: {
  id: string;
  name: string;
  type: "folder" | "file";
  deleted_at: string;
  expires_at: string;
  r2_object_key?: string;
  mime_type?: string;
  size_bytes?: number;
}[] = res?.ok ? (res.body?.data ?? []) : [];

const trashItems = trashRaw.map((t) => {
  let formattedDeletedAt = "-";
  let formattedExpiresAt = "-";
  let daysRemaining = 30;

  if (t.deleted_at) {
    const d = new Date(t.deleted_at);
    if (!isNaN(d.getTime())) {
      formattedDeletedAt = d.toLocaleDateString("id-ID", {
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    }
  }

  if (t.expires_at) {
    const exp = new Date(t.expires_at);
    if (!isNaN(exp.getTime())) {
      formattedExpiresAt = exp.toLocaleDateString("id-ID", {
        day: "numeric",
        month: "short",
        year: "numeric",
      });
      const diffMs = exp.getTime() - Date.now();
      daysRemaining = Math.max(0, Math.ceil(diffMs / (1000 * 60 * 60 * 24)));
    }
  }

  return {
    id: t.id,
    name: t.name,
    type: t.type,
    deletedAt: formattedDeletedAt,
    expiresAt: formattedExpiresAt,
    daysRemaining,
    r2ObjectKey: t.r2_object_key || "",
    mimeType: t.mime_type || (t.type === "folder" ? "folder" : "application/octet-stream"),
    sizeBytes: t.size_bytes || 0,
  };
});
---

<DashboardLayout title="Recycle Bin (Trash)">
  <div class="flex flex-col gap-6 pb-10">
    <PageBanner
      title="Recycle Bin (Trash)"
      description="Dokumen yang dihapus akan tersimpan di sini sebelum dihapus permanen"
    >
      <Trash2 className="h-8 w-8 text-white" slot="icon" />
    </PageBanner>

    <TrashView client:load initialData={trashItems} />
  </div>
</DashboardLayout>