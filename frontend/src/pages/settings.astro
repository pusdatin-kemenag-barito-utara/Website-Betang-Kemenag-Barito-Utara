---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import PageBanner from "@/components/ui/PageBanner.astro";
import { Settings } from "lucide-react";
import { SettingsClient } from "@/components/Settings/SettingsClient";
import { apiGet, requireUser } from "@/lib/server";

let auth: any = { ok: false, user: null };
let settingsRes: any = { ok: false, body: null };

try {
  const cookie = Astro.request.headers.get("cookie") || "";
  [auth, settingsRes] = await Promise.all([
    requireUser(cookie, Astro.response.headers),
    apiGet("/settings", cookie, true, Astro.response.headers),
  ]);
} catch (e) {
  console.error("Settings SSR Error:", e);
}

if (!auth?.ok) {
  return Astro.redirect("/login");
}

// Hanya super admin yang boleh mengakses pengaturan sistem.
const isSuperAdmin = auth?.user?.isSuperAdmin ?? false;
if (!isSuperAdmin) {
  return Astro.redirect("/");
}

const initialSettings = settingsRes?.ok && settingsRes.body?.data
  ? settingsRes.body.data
  : {
      disable_right_click: true,
      disable_print_shortcut: false,
      enable_watermark: false,
      max_upload_size_mb: 100,
      default_share_expiry_hours: 24,
      default_pdf_viewer_mode: "iframe",
    };
---

<DashboardLayout title="Pengaturan Sistem">
  <div class="flex flex-col gap-6 w-full pb-12">
    <PageBanner
      title="Pengaturan Sistem"
      description="Konfigurasi sistem keamanan berkas, integrasi Cloudflare R2, dan preferensi antarmuka aplikasi secara menyeluruh."
    >
      <Settings className="h-8 w-8 text-white" slot="icon" />
    </PageBanner>

    <SettingsClient client:load initialSettings={initialSettings} currentUser={auth.user} />
  </div>
</DashboardLayout>