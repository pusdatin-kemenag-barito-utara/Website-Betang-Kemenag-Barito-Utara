---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import PageBanner from "@/components/ui/PageBanner.astro";
import { FolderOpen } from "lucide-react";
import { FileBrowserView } from "@/components/FileBrowser/FileBrowserView";
import { apiGet, requireUser } from "@/lib/server";
import { formatFileSize } from "@/lib/utils";
import { format } from "date-fns";
import { id } from "date-fns/locale";

const folderId = Astro.params.folderId || "root";
const q = Astro.url.searchParams.get("q") || "";

let auth: any = { ok: false, user: null };
let contentsRes: any = { ok: false, body: null };
let breadcrumbsRes: any = { ok: false, body: null };

try {
  const cookie = Astro.request.headers.get("cookie") || "";
  [auth, contentsRes, breadcrumbsRes] = await Promise.all([
    requireUser(cookie),
    apiGet(`/folders/${encodeURIComponent(folderId)}${q ? `?q=${encodeURIComponent(q)}` : ""}`, cookie),
    apiGet(`/folders/${encodeURIComponent(folderId)}/breadcrumbs`, cookie),
  ]);
} catch (e) {
  console.error("Folder SSR Error:", e);
}

if (!auth?.ok) {
  return Astro.redirect("/login");
}

// Bidang deprecated: seluruh pengguna memakai global (migrasi dari Pusdatin).
const userBidangId = "global";

const contents = contentsRes?.ok ? contentsRes.body?.data : null;
const folders: any[] = contents?.folders ?? [];
const files: any[] = contents?.files ?? [];

const formatDate = (dateStr: string | null | undefined) => {
  if (!dateStr) return "-";
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return "-";
    return format(d, "d MMM yyyy", { locale: id });
  } catch {
    return "-";
  }
};

const items = [
  ...(folders || []).map((f: any) => {
    const folderSize = f.total_size || 0;
    const dateVal = f.updated_at || f.created_at;
    return {
      id: f.id,
      name: f.name,
      type: "folder" as const,
      size: folderSize > 0 ? formatFileSize(folderSize) : "-",
      rawSizeBytes: folderSize,
      updatedAt: formatDate(dateVal),
      rawDate: dateVal,
      createdAt: formatDate(f.created_at),
      isRestricted: f.is_restricted || false,
      isStarred: f.is_starred || false,
      color: f.color || null,
    };
  }),
  ...(files || []).map((f: any) => {
    const dateVal = f.updated_at || f.created_at;
    return {
      id: f.id,
      name: f.name,
      type: "file" as const,
      mimeType: f.mime_type,
      size: formatFileSize(f.size_bytes),
      rawSizeBytes: f.size_bytes,
      updatedAt: formatDate(dateVal),
      rawDate: dateVal,
      createdAt: formatDate(f.created_at),
      uploadedBy: f.uploaded_by,
      isRestricted: f.is_restricted || false,
      isStarred: f.is_starred || false,
      objectKey: f.r2_object_key,
    };
  }),
];

// Breadcrumbs backend berurutan daun -> akar; balik agar akar -> daun.
const breadcrumbs: { id: string; name: string }[] =
  breadcrumbsRes.ok && Array.isArray(breadcrumbsRes.body?.data)
    ? [...breadcrumbsRes.body.data].reverse()
    : [];

const currentFolderName =
  breadcrumbs.length > 0 ? breadcrumbs[breadcrumbs.length - 1].name : "File Browser";
const pageTitle =
  folderId === "root" ? "File Browser" : `${currentFolderName} - File Browser`;
---

<DashboardLayout title={pageTitle} description={`Telusuri dan kelola berkas arsip pada folder ${currentFolderName}`}>
  <div class="flex flex-col gap-6 pb-10">
    <PageBanner
      title="File Browser"
      description="Jelajahi dan kelola dokumen pada seksi/bidang Anda"
    >
      <FolderOpen className="h-8 w-8 text-white" slot="icon" />
    </PageBanner>

    <FileBrowserView
      client:load
      folderId={folderId}
      initialItems={items}
      breadcrumbs={breadcrumbs}
      userBidangId={userBidangId}
      initialSearchQuery={q}
    />
  </div>
</DashboardLayout>