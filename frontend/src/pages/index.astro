---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import PageBanner from "@/components/ui/PageBanner.astro";
import {
  LayoutDashboard,
  FileText,
  HardDrive,
  Clock,
  CalendarDays,
  FolderOpen,
  FolderKey,
  Star,
  Trash2,
  Users,
  Settings,
  ShieldCheck,
  ArrowRight,
  Download,
  Building2,
  CheckCircle2,
  FileCheck,
  HelpCircle,
} from "lucide-react";
import { apiGet, requireUser } from "@/lib/server";

function formatBytes(bytes: number, decimals = 2) {
  if (!+bytes) return "0 B";
  const k = 1024;
  const dm = decimals < 0 ? 0 : decimals;
  const sizes = ["B", "KB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
}

function getSplitBytes(bytes: number) {
  const formatted = formatBytes(bytes);
  const parts = formatted.split(" ");
  return { value: parts[0], unit: parts[1] || "" };
}

let auth: any = { ok: false, user: null };
let statsRes: any = { ok: false, body: null };
let storageRes: any = { ok: false, body: null };
let bidangRes: any = { ok: false, body: null };

try {
  const cookie = Astro.request.headers.get("cookie") || "";
  [auth, statsRes, storageRes, bidangRes] = await Promise.all([
    requireUser(cookie, Astro.response.headers),
    apiGet("/stats", cookie, false, Astro.response.headers),
    apiGet("/storage/usage", cookie, false, Astro.response.headers),
    apiGet("/bidang", cookie, false, Astro.response.headers),
  ]);
} catch (e) {
  console.error("Index SSR Error:", e);
}

if (!auth?.ok) {
  return Astro.redirect("/login");
}

const isSuperAdmin = auth?.user?.isSuperAdmin ?? false;
const userRole = auth?.user?.role || (isSuperAdmin ? "Super Admin" : "Admin Bidang");
const userBidang = auth?.user?.bidangName || "";
const userBidangId = auth?.user?.bidangId || "";

const stats = statsRes?.ok ? statsRes.body?.data : null;
const totalFiles = stats?.total_files ?? 0;
const totalStorage = stats?.total_storage ?? 0;
const storageFormatted = getSplitBytes(totalStorage);
const recentFilesCount = stats?.recent_24h_count ?? 0;
const thisMonthFilesCount = stats?.this_month_count ?? 0;
const recentUploads: { id: string; name: string; mime_type: string | null; size_bytes: number; created_at: string }[] = stats?.recent_uploads ?? [];

// Kuota storage (khusus Super Admin)
const storageData = storageRes?.ok ? storageRes.body?.data : null;
const usedBytes = storageData?.used_bytes ?? totalStorage;
const limitBytes = storageData?.limit_bytes ?? 15 * 1024 * 1024 * 1024;
const percentUsed = Math.min(100, Math.max(0, storageData?.percentage ?? (usedBytes / limitBytes) * 100));
const percentDisplay = percentUsed < 0.01 && percentUsed > 0 ? "< 0.01" : percentUsed.toFixed(1);

// Bidang list
const bidangRaw: {
  id: string;
  name: string;
  sort_order: number;
  doc_count: number;
  accessible_folder_ids?: string[];
  accessible_folder_names?: string[];
}[] = bidangRes?.ok ? (bidangRes.body?.data ?? []) : [];

const bidangs = [...bidangRaw].sort((a, b) => (b.doc_count - a.doc_count) || (a.sort_order - b.sort_order));

// Data spesifik Admin Bidang
const myBidang = bidangRaw.find((b) => b.id === userBidangId || (userBidang && b.name.toLowerCase() === userBidang.toLowerCase()));
const myDocCount = myBidang ? myBidang.doc_count : totalFiles;
const myAccessibleFolders = myBidang?.accessible_folder_names ?? [];
---

<DashboardLayout title={isSuperAdmin ? "Dashboard Statistik" : `Dashboard ${userBidang || "Admin Bidang"}`}>
  <div class="flex flex-col gap-6 pb-12">
    <!-- Header Banner Resmi Tunggal -->
    <PageBanner
      title={isSuperAdmin ? "Dashboard Statistik" : `Dashboard ${userBidang || "Seksi Bidang"}`}
      description={isSuperAdmin 
        ? "Ringkasan penggunaan dan aktivitas sistem E-Arsip Kementerian Agama Kabupaten Barito Utara"
        : `Pusat pengelolaan dan pemantauan arsip digital resmi ${userBidang || "Seksi Bidang"}`
      }
    >
      <LayoutDashboard className="h-8 w-8 text-white" slot="icon" />
    </PageBanner>

    <!-- KISI 4 METRIK STATISTIK -->
    <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4 w-full">
      {/* 1. Total Dokumen */}
      <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-colors">
        <div class="flex items-start justify-between gap-2">
          <div>
            <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">
              {isSuperAdmin ? "Total Dokumen" : "Dokumen Seksi"}
            </p>
            <h3 class="mt-2 text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
              {isSuperAdmin ? totalFiles : myDocCount}
            </h3>
          </div>
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
            <FileText className="h-5 w-5" />
          </div>
        </div>
        <p class="mt-4 text-xs text-slate-400 font-medium">
          {isSuperAdmin ? "Data Seluruh Kemenag" : (userBidang || "Seksi Anda")}
        </p>
      </div>

      {/* 2. Super Admin: Total Storage | Admin Bidang: Folder Dikelola */}
      {isSuperAdmin ? (
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-colors">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Total Storage</p>
              <h3 class="mt-2 text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
                {storageFormatted.value} <span class="text-sm font-bold text-slate-400">{storageFormatted.unit}</span>
              </h3>
            </div>
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
              <HardDrive className="h-5 w-5" />
            </div>
          </div>
          <p class="mt-4 text-xs text-slate-400 font-medium">
            Kapasitas R2 Terpakai
          </p>
        </div>
      ) : (
        <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-colors">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Folder Root Akses</p>
              <h3 class="mt-2 text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
                {myAccessibleFolders.length}
              </h3>
            </div>
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
              <FolderKey className="h-5 w-5" />
            </div>
          </div>
          <p class="mt-4 text-xs text-slate-400 font-medium">
            Folder Root yang Diizinkan
          </p>
        </div>
      )}

      {/* 3. Baru Diunggah */}
      <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-colors">
        <div class="flex items-start justify-between gap-2">
          <div>
            <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Baru Diunggah</p>
            <h3 class="mt-2 text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">{recentFilesCount}</h3>
          </div>
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
            <Clock className="h-5 w-5" />
          </div>
        </div>
        <p class="mt-4 text-xs text-slate-400 font-medium">
          Dalam 24 jam terakhir
        </p>
      </div>

      {/* 4. Bulan Ini */}
      <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-colors">
        <div class="flex items-start justify-between gap-2">
          <div>
            <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Bulan Ini</p>
            <h3 class="mt-2 text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">{thisMonthFilesCount}</h3>
          </div>
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
            <CalendarDays className="h-5 w-5" />
          </div>
        </div>
        <p class="mt-4 text-xs text-slate-400 font-medium">
          Dokumen diunggah bulan ini
        </p>
      </div>
    </div>

    <!-- AKSES CEPAT (Disesuaikan Peran) -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-5 sm:p-6 shadow-xs">
      <div class="mb-4">
        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Akses Cepat</h3>
        <p class="text-xs text-slate-500 mt-0.5">Pintasan navigasi kerja pengarsipan</p>
      </div>

      <div class={`grid gap-3 ${isSuperAdmin ? "grid-cols-2 sm:grid-cols-3 lg:grid-cols-5" : "grid-cols-1 sm:grid-cols-3"}`}>
        <!-- 1. File Browser -->
        <a
          href="/folders/root"
          class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
        >
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
            <FolderOpen className="h-4.5 w-4.5" />
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-bold text-slate-800 truncate">Jelajahi Berkas</span>
            <span class="block text-[11px] text-slate-400 truncate">Folder & Berkas Arsip</span>
          </div>
        </a>

        <!-- 2. Berbintang -->
        <a
          href="/starred"
          class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
        >
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
            <Star className="h-4.5 w-4.5" />
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-bold text-slate-800 truncate">Berbintang</span>
            <span class="block text-[11px] text-slate-400 truncate">Berkas Favorit & Prioritas</span>
          </div>
        </a>

        <!-- 3. Recycle Bin -->
        <a
          href="/trash"
          class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
        >
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
            <Trash2 className="h-4.5 w-4.5" />
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-bold text-slate-800 truncate">Tempat Sampah</span>
            <span class="block text-[11px] text-slate-400 truncate">Pemulihan Dokumen</span>
          </div>
        </a>

        {/* Khusus Super Admin: Manajemen Pengguna & Pengaturan Sistem */}
        {isSuperAdmin && (
          <a
            href="/users"
            class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
          >
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
              <Users className="h-4.5 w-4.5" />
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold text-slate-800 truncate">Manajemen Pengguna</span>
              <span class="block text-[11px] text-slate-400 truncate">Akun & Akses RBAC</span>
            </div>
          </a>
        )}

        {isSuperAdmin && (
          <a
            href="/settings"
            class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
          >
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
              <Settings className="h-4.5 w-4.5" />
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold text-slate-800 truncate">Pengaturan Sistem</span>
              <span class="block text-[11px] text-slate-400 truncate">Instansi & Kuota</span>
            </div>
          </a>
        )}
      </div>
    </div>

    <!-- TATA LETAK DUA KOLOM -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- KOLOM KIRI (8 Kolom) -->
      <div class="lg:col-span-8 flex flex-col gap-6">
        <!-- Dokumen Terbaru -->
        <div class="rounded-2xl border border-slate-200/80 bg-white overflow-hidden shadow-xs">
          <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4 bg-slate-50/50">
            <div>
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                {isSuperAdmin ? "Dokumen Terbaru" : `Dokumen Terbaru ${userBidang || "Seksi"}`}
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">Aktivitas unggahan berkas terakhir di sistem E-Arsip</p>
            </div>
            <a
              href="/folders/root"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-emerald-700 transition-colors"
            >
              <span>Buka File Browser</span>
              <ArrowRight className="h-3.5 w-3.5" />
            </a>
          </div>

          {recentUploads.length === 0 ? (
            <div class="p-8 text-center">
              <FileText className="h-8 w-8 text-slate-300 mx-auto mb-2" />
              <p class="text-xs font-bold text-slate-600">Belum ada dokumen yang diunggah</p>
            </div>
          ) : (
            <div class="w-full overflow-x-auto">
              <table class="w-full text-left text-sm border-collapse">
                <thead>
                  <tr class="border-b border-slate-100 bg-slate-50/80 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                    <th scope="col" class="px-6 py-3">Nama Dokumen</th>
                    <th scope="col" class="px-4 py-3 whitespace-nowrap">Ukuran</th>
                    <th scope="col" class="px-4 py-3 whitespace-nowrap">Waktu Unggah</th>
                    <th scope="col" class="px-6 py-3 text-right whitespace-nowrap">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {recentUploads.map((file) => {
                    const ext = (file.name.split(".").pop() || "FILE").toUpperCase();
                    return (
                      <tr class="hover:bg-slate-50/60 transition-colors">
                        <td class="px-6 py-3.5">
                          <div class="flex items-center gap-2.5 min-w-[200px]">
                            <span class="inline-flex items-center rounded-md bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold text-slate-600 border border-slate-200">
                              {ext}
                            </span>
                            <span class="font-medium text-slate-800 text-xs sm:text-sm truncate" title={file.name}>
                              {file.name}
                            </span>
                          </div>
                        </td>
                        <td class="px-4 py-3.5 whitespace-nowrap text-xs text-slate-500 font-mono">
                          {formatBytes(file.size_bytes)}
                        </td>
                        <td class="px-4 py-3.5 whitespace-nowrap text-xs text-slate-400">
                          {new Date(file.created_at).toLocaleDateString("id-ID", {
                            day: "numeric",
                            month: "short",
                            year: "numeric",
                            hour: "2-digit",
                            minute: "2-digit",
                          })}
                        </td>
                        <td class="px-6 py-3.5 text-right whitespace-nowrap">
                          <a
                            href={`/api/v1/files/stream?id=${file.id}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 hover:text-slate-900 transition-colors cursor-pointer"
                            title="Unduh / Buka Dokumen"
                          >
                            <Download className="h-3.5 w-3.5" />
                            <span>Buka</span>
                          </a>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </div>

        {/* Khusus Super Admin: Distribusi Arsip Seluruh Bidang */}
        {isSuperAdmin ? (
          <div class="rounded-2xl border border-slate-200/80 bg-white p-5 sm:p-6 shadow-xs">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
              <div>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                  Distribusi Arsip per Bidang
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">
                  Sebaran jumlah dokumen digital berdasarkan seksi kerja
                </p>
              </div>
              <a
                href="/users"
                class="text-xs font-bold text-slate-600 hover:text-emerald-700 transition-colors"
              >
                <span>Atur Hak Akses →</span>
              </a>
            </div>

            {bidangs.length === 0 ? (
              <div class="py-6 text-center text-slate-400">
                <p class="text-xs">Belum ada seksi/bidang terdaftar</p>
              </div>
            ) : (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {bidangs.map((b) => {
                  const docCount = b.doc_count || 0;
                  const ratio = totalFiles > 0 ? Math.round((docCount / totalFiles) * 100) : 0;
                  return (
                    <div class="p-3.5 rounded-xl border border-slate-200/60 bg-slate-50/40 flex flex-col justify-between">
                      <div class="flex items-center justify-between gap-2">
                        <span class="font-bold text-slate-800 text-xs truncate" title={b.name}>
                          {b.name}
                        </span>
                        <span class="text-xs font-mono font-bold text-slate-600 shrink-0">
                          {docCount} dok
                        </span>
                      </div>
                      <div class="mt-2.5">
                        <div class="h-1.5 w-full rounded-full bg-slate-200 overflow-hidden">
                          <div
                            class="h-full rounded-full bg-slate-600 transition-all"
                            style={`width: ${ratio}%`}
                          />
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        ) : (
          /* Khusus Admin Bidang: Daftar Folder Root Kerja yang Diberikan Hak Akses */
          <div class="rounded-2xl border border-slate-200/80 bg-white p-5 sm:p-6 shadow-xs">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
              <div>
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                  Folder Root yang Dapat Anda Kelola
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">
                  Folder utama yang diberikan hak akses oleh Super Admin untuk seksi Anda
                </p>
              </div>
              <a
                href="/folders/root"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:text-emerald-800 hover:underline"
              >
                <span>Buka di File Browser</span>
                <ArrowRight className="h-3.5 w-3.5" />
              </a>
            </div>

            {myAccessibleFolders.length === 0 ? (
              <div class="p-6 text-center text-slate-400 bg-slate-50/50 rounded-xl border border-dashed border-slate-200">
                <FolderKey className="h-8 w-8 text-slate-300 mx-auto mb-2" />
                <p class="text-xs font-bold text-slate-600">Belum Ada Hak Akses Folder Root</p>
                <p class="text-[11px] text-slate-400 mt-0.5">
                  Hubungi Super Admin untuk menambahkan hak akses folder root bagi seksi Anda.
                </p>
              </div>
            ) : (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {myAccessibleFolders.map((folderName: string) => (
                  <a
                    href="/folders/root"
                    class="group flex items-center justify-between p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/40 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
                  >
                    <div class="flex items-center gap-3 min-w-0">
                      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-emerald-700 border border-emerald-100 shadow-2xs">
                        <FolderOpen className="h-4.5 w-4.5" />
                      </div>
                      <div class="min-w-0">
                        <span class="block text-xs font-bold text-slate-800 truncate group-hover:text-emerald-800 transition-colors">
                          {folderName}
                        </span>
                        <span class="block text-[10px] text-slate-400">Folder Kerja Resmi</span>
                      </div>
                    </div>
                    <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 border border-emerald-200/60 shrink-0">
                      <CheckCircle2 className="h-3 w-3" />
                      <span>Aktif</span>
                    </span>
                  </a>
                ))}
              </div>
            )}
          </div>
        )}
      </div>

      <!-- KOLOM KANAN (4 Kolom): Dipisahkan Berdasarkan Peran Pengguna -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        {isSuperAdmin ? (
          /* ================= SUPER ADMIN PANELS ================= */
          <>
            <!-- Kapasitas Cloud Storage (Hanya Super Admin) -->
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Kapasitas Cloud R2</h3>
                <span class="text-xs font-mono font-bold text-slate-600">
                  {percentDisplay}%
                </span>
              </div>

              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs font-medium text-slate-600">
                  <span>{formatBytes(usedBytes)}</span>
                  <span class="text-slate-400">{formatBytes(limitBytes)}</span>
                </div>
                <div class="h-2 w-full rounded-full bg-slate-100 overflow-hidden border border-slate-200">
                  <div
                    class="h-full rounded-full bg-emerald-600 transition-all"
                    style={`width: ${Math.max(1, percentUsed)}%`}
                  />
                </div>
                <div class="flex items-center justify-between text-[11px] text-slate-400 pt-1">
                  <span>Kapasitas Tersedia</span>
                  <span class="font-medium text-slate-600">{formatBytes(Math.max(0, limitBytes - usedBytes))}</span>
                </div>
              </div>
            </div>

            <!-- Status Sistem (Hanya Super Admin) -->
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs">
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Status Sistem</h3>
              <div class="space-y-2.5">
                <div class="flex items-center justify-between py-2 border-b border-slate-100 text-xs">
                  <span class="text-slate-500">Core Backend</span>
                  <span class="font-medium text-slate-800">Go Fiber v3</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-slate-100 text-xs">
                  <span class="text-slate-500">Database</span>
                  <span class="font-medium text-slate-800">PostgreSQL</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-slate-100 text-xs">
                  <span class="text-slate-500">Akses Folder</span>
                  <span class="font-medium text-emerald-700">RBAC Aktif</span>
                </div>
                <div class="flex items-center justify-between py-2 text-xs">
                  <span class="text-slate-500">Cloud Storage</span>
                  <span class="font-medium text-slate-800">Cloudflare R2</span>
                </div>
              </div>
            </div>
          </>
        ) : (
          /* ================= ADMIN BIDANG PANELS ================= */
          <>
            <!-- Profil Singkat Seksi Bidang -->
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs">
              <div class="flex items-center gap-3 border-b border-slate-100 pb-3 mb-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                  <Building2 className="h-5 w-5" />
                </div>
                <div class="min-w-0">
                  <h3 class="text-sm font-bold text-slate-900 truncate">
                    {userBidang || "Seksi Kerja"}
                  </h3>
                  <span class="text-[11px] font-medium text-slate-400">
                    Kemenag Kabupaten Barito Utara
                  </span>
                </div>
              </div>

              <div class="space-y-2 text-xs">
                <div class="flex items-center justify-between py-1.5 text-slate-600">
                  <span class="text-slate-400">Peran Akun</span>
                  <span class="font-semibold text-slate-800">Admin Bidang</span>
                </div>
                <div class="flex items-center justify-between py-1.5 text-slate-600">
                  <span class="text-slate-400">Status Akses</span>
                  <span class="inline-flex items-center gap-1 font-semibold text-emerald-700">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                    <span>Terverifikasi Aktif</span>
                  </span>
                </div>
                <div class="flex items-center justify-between py-1.5 text-slate-600">
                  <span class="text-slate-400">Folder Kerja</span>
                  <span class="font-semibold text-slate-800">{myAccessibleFolders.length} Folder Dikelola</span>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100">
                <a
                  href="/folders/root"
                  class="flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 transition-colors shadow-xs"
                >
                  <FolderOpen className="h-4 w-4" />
                  <span>Buka Berkas Seksi</span>
                </a>
              </div>
            </div>

            <!-- Petunjuk Pengarsipan Dokumen Resmi -->
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs">
              <div class="flex items-center gap-2 mb-3">
                <HelpCircle className="h-4 w-4 text-slate-500" />
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">
                  Petunjuk Pengarsipan
                </h3>
              </div>
              <ul class="space-y-2 text-xs text-slate-600">
                <li class="flex items-start gap-2">
                  <CheckCircle2 className="h-3.5 w-3.5 text-emerald-600 mt-0.5 shrink-0" />
                  <span>Unggah berkas resmi dalam format <strong>PDF</strong> atau <strong>Gambar</strong> resolusi jelas.</span>
                </li>
                <li class="flex items-start gap-2">
                  <CheckCircle2 className="h-3.5 w-3.5 text-emerald-600 mt-0.5 shrink-0" />
                  <span>Gunakan format penamaan standar instansi (misal: <em>SK_Nomor_Tahun.pdf</em>).</span>
                </li>
                <li class="flex items-start gap-2">
                  <CheckCircle2 className="h-3.5 w-3.5 text-emerald-600 mt-0.5 shrink-0" />
                  <span>Berkas yang dihapus tersimpan selama <strong>30 hari</strong> di Tempat Sampah sebelum dibersihkan permanen.</span>
                </li>
                <li class="flex items-start gap-2">
                  <CheckCircle2 className="h-3.5 w-3.5 text-emerald-600 mt-0.5 shrink-0" />
                  <span>Tandai berkas penting dengan <strong>Berbintang</strong> agar mudah diakses kembali.</span>
                </li>
              </ul>
            </div>
          </>
        )}
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ totalFiles, totalStorage, recentFilesCount }}>
    if (typeof window !== "undefined") {
      if (window.dataLayer && Array.isArray(window.dataLayer)) {
        window.dataLayer.push({
          event: "view_dashboard_stats",
          total_files: totalFiles,
          total_storage_bytes: totalStorage,
          recent_files_count: recentFilesCount,
        });
      }
      if (typeof window.gtag === "function") {
        window.gtag("event", "view_dashboard_stats", {
          total_files: totalFiles,
          total_storage_bytes: totalStorage,
          recent_files_count: recentFilesCount,
        });
      }
    }
  </script>
</DashboardLayout>