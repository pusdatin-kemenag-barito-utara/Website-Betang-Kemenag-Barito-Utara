---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import PageBanner from "@/components/ui/PageBanner.astro";
import { LayoutDashboard, FileText, HardDrive, Clock, CalendarDays } from "lucide-react";
import { apiGet, requireUser } from "@/lib/server";

function formatBytes(bytes: number, decimals = 2) {
  if (!+bytes) return "0 B"
  const k = 1024
  const dm = decimals < 0 ? 0 : decimals
  const sizes = ["B", "KB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB"]
  const i = Math.floor(Math.log(bytes) / Math.log(k))
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`
}

function getSplitBytes(bytes: number) {
  const formatted = formatBytes(bytes)
  const parts = formatted.split(" ")
  return { value: parts[0], unit: parts[1] || "" }
}

function getIconClassForMimeType(mimeType: string | null) {
  if (!mimeType) return "text-slate-500"
  if (mimeType.includes("pdf")) return "text-rose-500"
  if (mimeType.includes("image")) return "text-emerald-500"
  return "text-slate-500"
}

let auth: any = { ok: false, user: null };
let statsRes: any = { ok: false, body: null };

try {
  const cookie = Astro.request.headers.get("cookie") || "";
  [auth, statsRes] = await Promise.all([
    requireUser(cookie, Astro.response.headers),
    apiGet("/stats", cookie, false, Astro.response.headers),
  ]);
} catch (e) {
  console.error("Index SSR Error:", e);
}

if (!auth?.ok) {
  return Astro.redirect("/login");
}

const isSuperAdmin = auth?.user?.isSuperAdmin ?? false;
const stats = statsRes?.ok ? statsRes.body?.data : null;

const totalFiles = stats?.total_files ?? 0;
const totalStorage = stats?.total_storage ?? 0;
const storageFormatted = getSplitBytes(totalStorage);
const recentFilesCount = stats?.recent_24h_count ?? 0;
const thisMonthFilesCount = stats?.this_month_count ?? 0;
const recentUploads: { id: string; name: string; mime_type: string | null; size_bytes: number; created_at: string }[] = stats?.recent_uploads ?? [];
---

<DashboardLayout title="Dashboard Statistik">
  <div class="flex flex-col gap-8 pb-10">
    <PageBanner
      title="Dashboard Statistik"
      description="Ringkasan penggunaan sistem E-Arsip Kementerian Agama Kabupaten Barito Utara"
    >
      <LayoutDashboard className="h-8 w-8 text-white" slot="icon" />
    </PageBanner>

    {/* Kisi Statistik */}
    <div class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4 w-full">
      <div class="group relative overflow-hidden rounded-2xl sm:rounded-3xl bg-white p-4 sm:p-8 shadow-sm ring-1 ring-slate-100 transition-all hover:shadow-lg hover:ring-emerald-100 flex flex-col justify-between">
        <div class="absolute right-0 top-0 -mt-4 -mr-4 h-16 w-16 sm:h-24 sm:w-24 rounded-full bg-emerald-50 opacity-50 transition-transform group-hover:scale-150" />
        <div class="relative flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <p class="text-[9px] sm:text-xs font-bold tracking-wider text-slate-500 uppercase truncate">Total Dokumen</p>
            <h3 class="mt-1 sm:mt-2 text-xl sm:text-4xl font-black text-slate-900 truncate">{totalFiles || 0}</h3>
          </div>
          <div class="flex-shrink-0 flex h-8 w-8 sm:h-16 sm:w-16 items-center justify-center rounded-lg sm:rounded-2xl bg-emerald-100 text-emerald-600 shadow-inner">
            <FileText className="h-4 w-4 sm:h-8 sm:w-8" />
          </div>
        </div>
        <div class="relative mt-3 sm:mt-6 flex items-center gap-1 sm:gap-2 text-[9px] sm:text-xs font-medium text-emerald-600 min-w-0">
          <span class="truncate block w-full">Data {isSuperAdmin ? "Seluruh Kemenag" : "Bidang Anda"}</span>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl sm:rounded-3xl bg-white p-4 sm:p-8 shadow-sm ring-1 ring-slate-100 transition-all hover:shadow-lg hover:ring-blue-100 flex flex-col justify-between">
        <div class="absolute right-0 top-0 -mt-4 -mr-4 h-16 w-16 sm:h-24 sm:w-24 rounded-full bg-blue-50 opacity-50 transition-transform group-hover:scale-150" />
        <div class="relative flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <p class="text-[9px] sm:text-xs font-bold tracking-wider text-slate-500 uppercase truncate">Total Storage</p>
            <h3 class="mt-1 sm:mt-2 text-xl sm:text-4xl font-black text-slate-900 truncate">
              {storageFormatted.value} <span class="text-[10px] sm:text-xl text-slate-400">{storageFormatted.unit}</span>
            </h3>
          </div>
          <div class="flex-shrink-0 flex h-8 w-8 sm:h-16 sm:w-16 items-center justify-center rounded-lg sm:rounded-2xl bg-blue-100 text-blue-600 shadow-inner">
            <HardDrive className="h-4 w-4 sm:h-8 sm:w-8" />
          </div>
        </div>
        <div class="relative mt-3 sm:mt-6 flex items-center gap-1 sm:gap-2 text-[9px] sm:text-xs font-medium text-slate-500 min-w-0">
          <span class="truncate block w-full">Kapasitas Terpakai</span>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl sm:rounded-3xl bg-white p-4 sm:p-8 shadow-sm ring-1 ring-slate-100 transition-all hover:shadow-lg hover:ring-orange-100 flex flex-col justify-between">
        <div class="absolute right-0 top-0 -mt-4 -mr-4 h-16 w-16 sm:h-24 sm:w-24 rounded-full bg-orange-50 opacity-50 transition-transform group-hover:scale-150" />
        <div class="relative flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <p class="text-[9px] sm:text-xs font-bold tracking-wider text-slate-500 uppercase truncate">Baru Diunggah</p>
            <h3 class="mt-1 sm:mt-2 text-xl sm:text-4xl font-black text-slate-900 truncate">{recentFilesCount}</h3>
          </div>
          <div class="flex-shrink-0 flex h-8 w-8 sm:h-16 sm:w-16 items-center justify-center rounded-lg sm:rounded-2xl bg-orange-100 text-orange-600 shadow-inner">
            <Clock className="h-4 w-4 sm:h-8 sm:w-8" />
          </div>
        </div>
        <div class="relative mt-3 sm:mt-6 flex items-center gap-1 sm:gap-2 text-[9px] sm:text-xs font-medium text-slate-500 min-w-0">
          <span class="truncate block w-full">Dalam 24 jam terakhir</span>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl sm:rounded-3xl bg-white p-4 sm:p-8 shadow-sm ring-1 ring-slate-100 transition-all hover:shadow-lg hover:ring-purple-100 flex flex-col justify-between">
        <div class="absolute right-0 top-0 -mt-4 -mr-4 h-16 w-16 sm:h-24 sm:w-24 rounded-full bg-purple-50 opacity-50 transition-transform group-hover:scale-150" />
        <div class="relative flex items-start justify-between gap-2">
          <div class="min-w-0 flex-1">
            <p class="text-[9px] sm:text-xs font-bold tracking-wider text-slate-500 uppercase truncate">Bulan Ini</p>
            <h3 class="mt-1 sm:mt-2 text-xl sm:text-4xl font-black text-slate-900 truncate">{thisMonthFilesCount}</h3>
          </div>
          <div class="flex-shrink-0 flex h-8 w-8 sm:h-16 sm:w-16 items-center justify-center rounded-lg sm:rounded-2xl bg-purple-100 text-purple-600 shadow-inner">
            <CalendarDays className="h-4 w-4 sm:h-8 sm:w-8" />
          </div>
        </div>
        <div class="relative mt-3 sm:mt-6 flex items-center gap-1 sm:gap-2 text-[9px] sm:text-xs font-medium text-slate-500 min-w-0">
          <span class="truncate block w-full">Dokumen diunggah bulan ini</span>
        </div>
      </div>
    </div>

    {/* Tabel Dokumen Terbaru */}
    <div class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-100">
      <div class="flex items-center justify-between border-b border-slate-100 px-4 md:px-8 py-6 bg-slate-50/50">
        <div>
          <h3 class="text-lg font-bold text-slate-900">Dokumen Terbaru</h3>
          <p class="text-xs font-medium text-slate-500 mt-1">Aktivitas unggahan terakhir di sistem E-Arsip</p>
        </div>
      </div>

      {recentUploads.length === 0 ? (
        <div class="p-8">
          <div class="flex h-48 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50/50">
            <FileText className="mb-3 h-8 w-8 text-slate-300" />
            <p class="text-sm font-bold text-slate-500">Belum ada dokumen</p>
            <p class="mt-1 text-xs text-slate-400">Dokumen yang baru diunggah akan muncul di sini</p>
          </div>
        </div>
      ) : (
        <div class="w-full">
          <div class="hidden md:flex w-full bg-slate-50/90 border-b border-slate-100">
            <div class="w-1/2 px-4 md:px-8 py-3 text-[11px] font-bold tracking-wider text-slate-500 uppercase">Nama Dokumen</div>
            <div class="w-1/4 px-4 md:px-8 py-3 text-[11px] font-bold tracking-wider text-slate-500 uppercase">Ukuran</div>
            <div class="w-1/4 px-4 md:px-8 py-3 text-[11px] font-bold tracking-wider text-slate-500 uppercase text-right">Waktu Unggah</div>
          </div>
          <div class="flex flex-col divide-y divide-slate-50">
            {recentUploads.map((file) => (
              <div class="flex flex-col md:flex-row md:items-center hover:bg-slate-50/50 transition-colors py-3 md:py-0">
                <div class="w-full md:w-1/2 px-4 md:px-8 py-1 md:py-3 flex items-center gap-3">
                  <div class="flex-shrink-0">
                    <FileText className={`h-5 w-5 ${getIconClassForMimeType(file.mime_type)}`} />
                  </div>
                  <span class="font-semibold text-slate-700 text-sm truncate">{file.name}</span>
                </div>
                <div class="w-full md:w-1/4 px-4 md:px-8 py-1 md:py-3 text-sm text-slate-500">
                  <span class="md:hidden text-xs font-bold uppercase tracking-wider text-slate-400 mr-2">Ukuran:</span>
                  {formatBytes(file.size_bytes)}
                </div>
                <div class="w-full md:w-1/4 px-4 md:px-8 py-1 md:py-3 text-sm text-slate-500 md:text-right">
                  <span class="md:hidden text-xs font-bold uppercase tracking-wider text-slate-400 mr-2">Waktu:</span>
                  {new Date(file.created_at).toLocaleDateString("id-ID", {
                    day: "numeric",
                    month: "short",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                  })}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <script is:inline define:vars={{ totalFiles, totalStorage, recentFilesCount }}>
    if (typeof window !== "undefined") {
      if (window.dataLayer && Array.isArray(window.dataLayer)) {
        window.dataLayer.push({
          event: "view_dashboard_stats",
          total_files: totalFiles,
          total_storage_bytes: totalStorage,
          recent_files_count: recentFilesCount,
        });
      }
      if (typeof window.gtag === "function") {
        window.gtag("event", "view_dashboard_stats", {
          total_files: totalFiles,
          total_storage_bytes: totalStorage,
          recent_files_count: recentFilesCount,
        });
      }
    }
  </script>
</DashboardLayout>