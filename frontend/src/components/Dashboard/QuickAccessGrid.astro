---
import { FolderOpen, Star, Trash2, Users, Settings } from "lucide-react";

interface Props {
  isSuperAdmin: boolean;
}

const { isSuperAdmin } = Astro.props;
---

<div class="rounded-2xl border border-slate-200/80 bg-white p-5 sm:p-6 shadow-xs">
  <div class="mb-4">
    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Akses Cepat</h3>
    <p class="text-xs text-slate-500 mt-0.5">Pintasan navigasi kerja pengarsipan</p>
  </div>

  <div class={`grid gap-3 ${isSuperAdmin ? "grid-cols-2 sm:grid-cols-3 lg:grid-cols-5" : "grid-cols-1 sm:grid-cols-3"}`}>
    <!-- 1. File Browser -->
    <a
      href="/folders/root"
      class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
    >
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
        <FolderOpen className="h-4.5 w-4.5" />
      </div>
      <div class="min-w-0">
        <span class="block text-xs font-bold text-slate-800 truncate">Jelajahi Berkas</span>
        <span class="block text-[11px] text-slate-400 truncate">Folder & Berkas Arsip</span>
      </div>
    </a>

    <!-- 2. Berbintang -->
    <a
      href="/starred"
      class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
    >
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
        <Star className="h-4.5 w-4.5" />
      </div>
      <div class="min-w-0">
        <span class="block text-xs font-bold text-slate-800 truncate">Berbintang</span>
        <span class="block text-[11px] text-slate-400 truncate">Berkas Favorit & Prioritas</span>
      </div>
    </a>

    <!-- 3. Recycle Bin -->
    <a
      href="/trash"
      class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
    >
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
        <Trash2 className="h-4.5 w-4.5" />
      </div>
      <div class="min-w-0">
        <span class="block text-xs font-bold text-slate-800 truncate">Tempat Sampah</span>
        <span class="block text-[11px] text-slate-400 truncate">Pemulihan Dokumen</span>
      </div>
    </a>

    <!-- Khusus Super Admin: Manajemen Pengguna & Pengaturan Sistem -->
    {isSuperAdmin && (
      <a
        href="/users"
        class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
      >
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
          <Users className="h-4.5 w-4.5" />
        </div>
        <div class="min-w-0">
          <span class="block text-xs font-bold text-slate-800 truncate">Manajemen Pengguna</span>
          <span class="block text-[11px] text-slate-400 truncate">Akun & Akses RBAC</span>
        </div>
      </a>
    )}

    {isSuperAdmin && (
      <a
        href="/settings"
        class="flex items-center gap-3 p-3.5 rounded-xl border border-slate-200/70 bg-slate-50/50 hover:bg-slate-100/80 hover:border-slate-300 transition-all cursor-pointer"
      >
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-700 border border-slate-200 shadow-2xs">
          <Settings className="h-4.5 w-4.5" />
        </div>
        <div class="min-w-0">
          <span class="block text-xs font-bold text-slate-800 truncate">Pengaturan Sistem</span>
          <span class="block text-[11px] text-slate-400 truncate">Instansi & Kuota</span>
        </div>
      </a>
    )}
  </div>
</div>
